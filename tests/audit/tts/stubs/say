#!/usr/bin/env bash
s=$(date +%s.%N); args=$(printf '%s ' "$@" | head -c 200 | tr '"\\' "''"); in=""; [ -t 0 ] || in=$(head -c 200 | tr '"\\\n' "''' ")
trap 'echo "{\"tool\":\"say\",\"args\":\"$args\",\"stdin\":\"$in\",\"start\":$s,\"killed\":1}" >> "$STUB_LOG"; exit 143' TERM INT
sleep "${STUB_PLAY_SEC:-0.5}" & wait $!
echo "{\"tool\":\"say\",\"args\":\"$args\",\"stdin\":\"$in\",\"start\":$s,\"end\":$(date +%s.%N),\"killed\":0}" >> "$STUB_LOG"
